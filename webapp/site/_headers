# Response headers, for static hosts that read a _headers file (Cloudflare, Netlify).
# Copied into every brand's site by the build.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/img/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=86400
